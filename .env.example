# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hub:hub_local_pass@localhost:5432/hub_billing
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=hub_billing:

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_isso_em_producao_use_openssl_rand_base64_64
JWT_EXPIRY=8h
REFRESH_TOKEN_EXPIRY=30d

# ─── Gateways ─────────────────────────────────────────────────────────────────

# Asaas
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_BASE_URL=https://api.asaas.com/v3

# Stripe (Checkout Sessions — cartão, PIX e boleto)
# Webhook: registre pela tela Configurações → Gateway → Stripe → "Registrar
# Webhook" (salva o signing secret automaticamente), ou manualmente em
# https://dashboard.stripe.com/webhooks apontando para
# https://seu-dominio.com/api/v1/webhooks/gateway/stripe
# STRIPE_SECRET_KEY=sk_test_ou_sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_test_ou_pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago (webhook por cobrança)
# MERCADOPAGO_WEBHOOK_URL=https://seu-dominio.com/api/v1/webhooks/gateway/mercadopago
# MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxx

# LivePix (client_credentials — https://docs.livepix.gg/api)
# Webhook: configure em POST /v2/webhooks apontando para
# https://seu-dominio.com/api/v1/webhooks/gateway/livepix
# LIVEPIX_CLIENT_ID=
# LIVEPIX_CLIENT_SECRET=
# LIVEPIX_SCOPE=

# ─── Filas ────────────────────────────────────────────────────────────────────
WEBHOOK_QUEUE_CONCURRENCY=5
INTERNAL_EVENTS_QUEUE_CONCURRENCY=3
LICENSE_EXPIRY_CRON=0 2 * * *   # Roda às 2h da manhã

# Sincronização de pendentes (rede de segurança além do webhook)
# MP: PAYMENTS_PENDING_SYNC_ENABLED=true / PAYMENTS_PENDING_SYNC_BATCH=20 / PAYMENTS_PENDING_SYNC_DELAY_MS=350
# Stripe: STRIPE_PENDING_SYNC_ENABLED=true / STRIPE_PENDING_SYNC_BATCH=20 / STRIPE_PENDING_SYNC_DELAY_MS=350

# ─── Notificações ─────────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@seuhub.com.br

# ─── Observabilidade ──────────────────────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=info
